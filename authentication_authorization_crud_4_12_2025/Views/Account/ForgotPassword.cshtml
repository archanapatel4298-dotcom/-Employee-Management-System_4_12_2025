@model authentication_authorization_crud_4_12_2025.Models.ForgotPassword
@{
    ViewData["Title"] = "ForgotPassword";
}

<h1>ForgotPassword</h1>

<div class="container">
    <div class="row mt-lg-5">
        <div class="col-4 offset-4 border border-primary rounded p-4">
            <h4 class="text-center mb-3">Reset Password</h4>

            <h6 class="text-success text-center">@TempData["success"]</h6>
            <h6 class="text-danger text-center">@TempData["error"]</h6>

            <form asp-action="ForgotPassword" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div class="form-group mb-3">
                    <label asp-for="Username"></label>
                    <input asp-for="Username" class="form-control" placeholder="Enter username or email" autocomplete="off" />
                    <span class="text-danger" asp-validation-for="Username"></span>
                </div>

                <div class="form-group mb-3 position-relative">
                    <label asp-for="Password">New Password</label>
                    <input id="password" asp-for="Password" type="password" class="form-control" placeholder="Enter new password" autocomplete="off" />
                    <i id="open" class="fa fa-eye" style="position:absolute; right:12px; top:38px; cursor:pointer;"></i>
                    <i id="closed" class="fa fa-eye-slash" style="position:absolute; right:12px; top:38px; cursor:pointer; display:none;"></i>
                    <span class="text-danger" asp-validation-for="Password"></span>
                </div>

                <div class="form-group mb-3 position-relative">
                    <label for="confirmPassword">Confirm New Password</label>
                    <input id="confirmPassword" type="password" class="form-control" placeholder="Confirm new password" autocomplete="off" />
                    <i id="openConfirm" class="fa fa-eye" style="position:absolute; right:12px; top:38px; cursor:pointer;"></i>
                    <i id="closedConfirm" class="fa fa-eye-slash" style="position:absolute; right:12px; top:38px; cursor:pointer; display:none;"></i>
                    <span id="confirmError" class="text-danger" style="display:none;">Passwords do not match</span>
                </div>

                <div class="form-group mb-3">
                    <input type="submit" class="btn btn-block btn-primary w-100" value="Reset Password" />
                </div>
            </form>

            <div class="text-center">
                <a asp-controller="main" asp-action="Index" class="text-primary">Back to Login</a>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" />

@section scripts
{
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        $(function () {
            // Password show/hide for new password
            $("#open").on("click", function () {
                $(this).hide(); $("#closed").show(); $("#password").attr("type", "text");
            });
            $("#closed").on("click", function () {
                $(this).hide(); $("#open").show(); $("#password").attr("type", "password");
            });

            // Password show/hide for confirm password
            $("#openConfirm").on("click", function () {
                $(this).hide(); $("#closedConfirm").show(); $("#confirmPassword").attr("type", "text");
            });
            $("#closedConfirm").on("click", function () {
                $(this).hide(); $("#openConfirm").show(); $("#confirmPassword").attr("type", "password");
            });

            // Validate passwords match before submit
            $("form").on("submit", function (e) {
                var p = $("#password").val() || "";
                var c = $("#confirmPassword").val() || "";
                if (p.length === 0 || c.length === 0) {
                    // allow server-side validation to handle empty fields
                    return;
                }
                if (p !== c) {
                    e.preventDefault();
                    $("#confirmError").show();
                } else {
                    $("#confirmError").hide();
                }
            });
        });
    </script>
}
